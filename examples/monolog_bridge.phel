(ns phel-log-examples.monolog-bridge
  (:require phel.log :as log))

;; ===========================================================================
;; Monolog bridge: forward phel.log events into any Monolog handler.
;; This example uses TestHandler so the result is inspectable, but the
;; same call shape works for Slack, Syslog, RotatingFile, Elasticsearch,
;; NewRelic, ... — any class implementing `Monolog\Handler\HandlerInterface`.
;;
;; Run: vendor/bin/phel run phel-log-examples.monolog-bridge
;; Exits non-zero on any failed assertion.
;; ===========================================================================

(def failed (atom 0))

(defn- assert! [name pred]
  (if pred
    (println " [OK] " name)
    (do (println " [ERR]" name)
        (swap! failed inc))))

;; ---------------------------------------------------------------------------
;; 1. Wire a Monolog handler as a phel.log appender. One call: monolog-appender.
;; ---------------------------------------------------------------------------

(def handler (php/new \Monolog\Handler\TestHandler))

(log/init! :trace
           [(log/monolog-appender {:handler handler :channel "smoke"})])

(println "\n== monolog-bridge ==")

;; ---------------------------------------------------------------------------
;; 2. Log through phel macros — every event lands as a Monolog\LogRecord.
;; ---------------------------------------------------------------------------

(log/trace  "trace-line")
(log/debug  "debug-line")
(log/info   "info-line"  {:user 42})
(log/warn   "warn-line")
(log/error  "error-line" {:order 7})
(log/fatal  "fatal-line")
(log/report "report-line")

(def records (php/-> handler (getRecords)))

(assert! "7 records captured" (= 7 (php/count records)))

;; ---------------------------------------------------------------------------
;; 3. Spot-check level mapping + context conversion.
;;    phel :info   -> Monolog level 200
;;    phel :data   -> Monolog $context (PHP assoc array, string keys)
;; ---------------------------------------------------------------------------

(let [info-rec (php/aget records 2)]
  (assert! ":info -> Monolog 200"
           (= 200 (php/-> (php/-> info-rec level) value)))
  (assert! "message preserved"
           (= "info-line" (php/-> info-rec message)))
  (assert! ":data lands in context"
           (= 42 (php/aget (php/-> info-rec context) "user")))
  (assert! "channel forwarded"
           (= "smoke" (php/-> info-rec channel))))

;; TestHandler convenience helpers — useful in real assertions.
(let [has-info  (php/-> handler (hasInfoRecords))
      has-error (php/-> handler (hasErrorRecords))]
  (assert! "TestHandler.hasInfoRecords"  has-info)
  (assert! "TestHandler.hasErrorRecords" has-error))

;; ---------------------------------------------------------------------------
;; 4. Construction guard: :handler is required.
;; ---------------------------------------------------------------------------

(assert! "monolog-appender without :handler throws"
         (try
           (log/monolog-appender {})
           false
           (catch \InvalidArgumentException _ true)))

(let [n (deref failed)]
  (if (= 0 n)
    (println "monolog-bridge OK\n")
    (do (println (str "monolog-bridge FAIL: " n " check(s) failed"))
        (php/exit 1))))
