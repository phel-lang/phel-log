(in-ns phel.log)

;; ===========================================================================
;; Public API: dispatch + level macros.
;;
;; A log call is:
;;   1. enabled? check (level + ns filter)             — fast path, no alloc
;;   2. build event map                                — single map alloc
;;   3. run :processors over the event                 — middleware
;;   4. fan out to every appender that accepts it      — side effects
;;
;; Macros snapshot the call-site namespace at expand time (via *ns*) so the
;; recorded :ns is the caller's, not phel.log itself.
;; ===========================================================================

(defn enabled?
  "True iff an event of `level` from `ns-str` would be written somewhere."
  [level ns-str]
  (let [cfg (get-config)]
    (and (level>= level (get cfg :min-level))
         (passes-filter? ns-str cfg))))

(defn apply-processors
  "Run each processor `(fn [event] event)` left-to-right over `event`."
  [event processors]
  (reduce (fn [ev proc] (proc ev)) event (or processors [])))

(defn emit!
  "Build, decorate, and dispatch an event. Internal: macros call this."
  [level ns-str message data]
  (when (enabled? level ns-str)
    (let [cfg     (get-config)
          base    (get cfg :base-data {})
          merged  (merge base (or data {}))
          event   (make-event level ns-str message merged)
          procd   (apply-processors event (get cfg :processors))]
      (foreach [appender (get cfg :appenders)]
        (write-event! appender procd)))))

(defn log-event!
  "Direct entrypoint for non-macro callers (PSR-3 adapter, tests).
   `level` keyword, `ns-str` string, `message` string, `data` map."
  [level ns-str message data]
  (emit! level ns-str message data))

;; ---------------------------------------------------------------------------
;; Macros. Capture *ns* at expand time. Argument shapes accepted:
;;
;;   (log/info "message")
;;   (log/info "message" {:user 42})
;;   (log/info ["composite" "message" "parts"])  ; vector -> joined w/ space
;;   (log/info ["composite" ...] {:k :v})
;; ---------------------------------------------------------------------------

(defmacro- deflevel
  "Define a level macro `name` that emits at `level-kw`."
  [macro-name level-kw]
  (let [args-sym  (gensym "args__")
        ns-string *ns*]
    `(defmacro ~macro-name [& ~args-sym]
       `(emit! ~~level-kw
               ~~ns-string
               ~(first ~args-sym)
               ~(second ~args-sym)))))

;; Note: the macros below shadow nothing in phel.core but DO shadow common
;; user identifiers if `:refer`red. Users should consume via alias:
;;   (:require phel.log :as log)
;;   (log/info "hello")

(defmacro trace
  "Log at :trace level. Args: message [data-map]."
  [& body]
  `(emit! :trace ~*ns* ~(first body) ~(second body)))

(defmacro debug
  "Log at :debug level. Args: message [data-map]."
  [& body]
  `(emit! :debug ~*ns* ~(first body) ~(second body)))

(defmacro info
  "Log at :info level. Args: message [data-map]."
  [& body]
  `(emit! :info ~*ns* ~(first body) ~(second body)))

(defmacro warn
  "Log at :warn level. Args: message [data-map]."
  [& body]
  `(emit! :warn ~*ns* ~(first body) ~(second body)))

(defmacro error
  "Log at :error level. Args: message [data-map]."
  [& body]
  `(emit! :error ~*ns* ~(first body) ~(second body)))

(defmacro fatal
  "Log at :fatal level. Args: message [data-map]."
  [& body]
  `(emit! :fatal ~*ns* ~(first body) ~(second body)))

(defmacro report
  "Log at :report level. Args: message [data-map].
   :report is for high-signal, audit-style events (deploys, manual ops) that
   should always go out regardless of the current :min-level threshold in
   most production configs."
  [& body]
  `(emit! :report ~*ns* ~(first body) ~(second body)))

;; ---------------------------------------------------------------------------
;; Convenience: timed block. Emits :info on entry/exit, :error on throw.
;; ---------------------------------------------------------------------------

(defmacro spy
  "Evaluate `expr` and log its value at :debug. Returns the value.
   Useful inside thread macros: `(-> x foo (log/spy) bar)`."
  [expr]
  (let [v-sym (gensym "spy-val__")]
    `(let [~v-sym ~expr]
       (emit! :debug ~*ns* ["spy =>" ~v-sym] nil)
       ~v-sym)))
