(in-ns phel.log)

;; ===========================================================================
;; Formatters. A formatter is `(fn [event] string)`. Pure, no I/O.
;;
;; Two stock formats:
;;   :line   "2026-05-16T10:21:33Z [INFO ] my-app.users - user logged in {...}"
;;   :json   {"level":"info","ns":"my-app.users","time":...,"message":"...",...}
;; ===========================================================================

(defn- iso-time
  "Format epoch-ms as ISO-8601 UTC: 2026-05-16T10:21:33.123Z."
  [time-ms]
  (let [secs    (php/intdiv time-ms 1000)
        millis  (php/% time-ms 1000)
        date-str (php/date "Y-m-d\\TH:i:s" secs)]
    (str date-str "." (php/sprintf "%03d" millis) "Z")))

(defn- pad-level
  "Right-pad an uppercase level name to 5 chars so columns align."
  [level]
  (php/str_pad (level-name level) 5))

(defn- data-empty?
  "True iff `data` carries nothing worth rendering. Treats nil and any
   zero-count collection as empty without calling PHP's `empty()` —
   which is a language construct that Phel can't invoke directly."
  [data]
  (or (nil? data)
      (and (or (php/is_array data)
               (php/is_a data \Countable))
           (php/== 0 (php/count data)))))

;; ---------------------------------------------------------------------------
;; Throwable serialisation. Stack trace as a string keeps the JSON wire
;; payload simple while preserving the human-readable form Monolog /
;; PHP loggers produce. `:previous` recurses one level deep with a
;; bounded chain length to defeat pathological exception loops.
;; ---------------------------------------------------------------------------

(def ^:private *max-previous-chain* 5)

(declare serialize-throwable)

(defn- previous-chain
  "Walk `\\Throwable::getPrevious()` up to `*max-previous-chain*` deep
   and return a vector of serialised maps."
  [t]
  (loop [cur   (php/-> t (getPrevious))
         depth 0
         acc   []]
    (cond
      (nil? cur)                       acc
      (php/<= *max-previous-chain* depth) (push acc {:truncated true})
      :else (recur (php/-> cur (getPrevious))
                   (php/+ depth 1)
                   (push acc (serialize-throwable cur))))))

(defn serialize-throwable
  "Convert a `\\Throwable` into a plain map: class, message, code,
   file, line, trace (one string), and a bounded :previous chain.
   Returns the input unchanged if it isn't a Throwable."
  [t]
  (if (php/is_a t \Throwable)
    {:class    (php/get_class t)
     :message  (php/-> t (getMessage))
     :code     (php/-> t (getCode))
     :file     (php/-> t (getFile))
     :line     (php/-> t (getLine))
     :trace    (php/-> t (getTraceAsString))
     :previous (previous-chain t)}
    t))

(defn- short-throwable-tag
  "Build the inline ` | Class: message (file:line)` segment for the
   line formatter. Single short line so the event still fits on one
   row; the full trace lives in the json formatter."
  [t]
  (let [klass (php/get_class t)
        msg   (php/-> t (getMessage))
        file  (php/basename (php/-> t (getFile)))
        line  (php/-> t (getLine))]
    (str " | " klass ": " msg " (" file ":" line ")")))

(defn format-line
  "Line formatter: human-readable one-line representation. Suitable for the
   console appender and most file appenders.
   Errors render as a short ` | Class: message (file:line)` tag."
  [event]
  (let [{:keys [level ns time-ms message data error]} event
        head (str (iso-time time-ms) " [" (pad-level level) "] " ns " - " message)
        body (if (data-empty? data) "" (str " " (print-str data)))
        tail (cond
               (nil? error)                 ""
               (php/is_a error \Throwable)  (short-throwable-tag error)
               :else                        (str " | " error))]
    (str head body tail)))

(defn format-json
  "JSON formatter: one event per line, machine-readable. Throwables are
   serialised in full (class, message, code, file, line, trace, previous
   chain) so log pipelines can inspect them without re-parsing."
  [event]
  (let [{:keys [level ns time-ms message data error]} event
        payload {:level   (name level)
                 :ns      ns
                 :time    (iso-time time-ms)
                 :time-ms time-ms
                 :message message
                 :data    data
                 :error   (when error
                            (if (php/is_a error \Throwable)
                              (serialize-throwable error)
                              (str error)))}]
    (json/encode payload)))

(def builtin-formatters
  "Built-in formatter keyword -> fn lookup."
  {:line format-line
   :json format-json})

(defn resolve-formatter
  "Resolve a formatter that is either a keyword (built-in) or a function."
  [f]
  (cond
    (keyword? f) (or (get builtin-formatters f)
                     (throw (php/new \InvalidArgumentException
                                     (str "Unknown formatter: " f))))
    (function? f) f
    :else (throw (php/new \InvalidArgumentException
                          "Formatter must be a keyword or function"))))
